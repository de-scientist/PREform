generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProgrammeCode {
  RN
  PN
}

model Programme {
  id          String        @id @default(cuid())
  code        ProgrammeCode @unique
  displayName String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
